+def _all_errors(schema: dict, data: Any) -> list[str]:
+    """Every way `data` fails `schema`, each with where it is — not only the first.
+    One at a time cost an agent six round trips for one short checkpoint, an enum
+    at a time (KinClaw, 2026-09-28)."""
+    validator = jsonschema.validators.validator_for(schema)(schema)
+    errors = sorted(validator.iter_errors(data), key=lambda e: [str(p) for p in e.absolute_path])
+    return [f"{'/'.join(str(p) for p in e.absolute_path) or '(top)'}: {e.message}" for e in errors]
+
