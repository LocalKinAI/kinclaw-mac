+    def _box_answers(self) -> bool:
+        try:
+            import requests
+
+            return requests.get(BOX_ASR_URL.split("/v1/")[0] + "/health", timeout=2).status_code == 200
+        except Exception:
+            return False
+
+    def _execute_box(
+        self, input_path: Path, model_size: str, language: Optional[str], output_dir: Path
+    ) -> ToolResult:
+        """The box's Qwen3-ASR for the words, whisper for when each was said."""
+        import numpy as np
+        import requests
+        from faster_whisper import WhisperModel
+
+        start = time.time()
+        with tempfile.TemporaryDirectory() as tmp:
+            wav = Path(tmp) / "audio.wav"
+            subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(input_path), "-vn", "-ac", "1",
+                            "-ar", "16000", "-c:a", "pcm_s16le", str(wav)], check=True)
+            with wave.open(str(wav)) as w:
+                pcm = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16)
+        total = len(pcm) / 16000
+
+        # When: whisper's words, each split into units with its time shared out among them.
+        try:
+            model = WhisperModel(model_size, device="cpu", compute_type="int8", local_files_only=True)
+        except Exception as exc:
+            raise RuntimeError(f"whisper {model_size} is not on the box (small is): {exc}") from exc
+        found, info = model.transcribe(pcm.astype(np.float32) / 32768.0, language=language,
+                                       word_timestamps=True, vad_filter=True)
+        heard_segments = []
+        for seg in found:
+            heard = []
+            for w in seg.words or []:
+                spoken = [u for u in _units(w.word) if _key(u)]
+                step = (w.end - w.start) / max(1, len(spoken))
+                heard += [(_key(u), w.start + i * step, w.start + (i + 1) * step) for i, u in enumerate(spoken)]
+            if heard:
+                heard_segments.append({"start": seg.start, "end": seg.end, "heard": heard})
+
+        # What: the box's ASR on stretches of up to _CHUNK_S, cut where whisper heard a pause.
+        chunks: list[list[dict]] = []
+        for s in heard_segments:
+            if chunks and s["end"] - chunks[-1][0]["start"] <= _CHUNK_S:
+                chunks[-1].append(s)
+            else:
+                chunks.append([s])
+        units_all: list[tuple[str, float, float, float]] = []
+        agreed = 0
+        box_language = None
+        for chunk in chunks:
+            t0 = max(0.0, chunk[0]["start"] - 0.25)
+            t1 = min(total, chunk[-1]["end"] + 0.25)
+            buf = io.BytesIO()
+            with wave.open(buf, "wb") as w:
+                w.setnchannels(1)
+                w.setsampwidth(2)
+                w.setframerate(16000)
+                w.writeframes(pcm[int(t0 * 16000):int(t1 * 16000)].tobytes())
+            params = {"enable_vad": "false"}
+            if language:
+                params["language"] = language
+            reply = requests.post(BOX_ASR_URL, params=params, timeout=600,
+                                  files={"file": ("chunk.wav", buf.getvalue(), "audio/wav")})
+            reply.raise_for_status()
+            body = reply.json()
+            box_language = box_language or body.get("language")
+            units = [u for u in _units(body.get("text", "")) if _key(u)]
+            if not units:
+                continue
+            times, ok = _pin([h for s in chunk for h in s["heard"]], units, t0, t1)
+            agreed += ok
+            units_all += [(u, a, b, c) for u, (a, b, c) in zip(units, times)]
+
+        # Segments end at a full stop or a pause; a unit is a "word".
+        segments: list[dict] = []
+        word_timestamps: list[dict] = []
+        current: list[dict] = []
+
+        def close() -> None:
+            if current:
+                segments.append({
+                    "id": len(segments),
+                    "start": current[0]["start"],
+                    "end": current[-1]["end"],
+                    "text": "".join(w["_text"] for w in current).strip(),
+                    "words": [{k: v for k, v in w.items() if k != "_text"} for w in current],
+                })
+                current.clear()
+
+        last_start = 0.0
+        for unit, a, b, confidence in units_all:
+            a = max(a, last_start)
+            b = max(b, a + 0.01)
+            last_start = a
+            if current and a - current[-1]["end"] > _PAUSE_S:
+                close()
+            word = {"word": unit.strip(), "start": round(float(a), 3), "end": round(float(b), 3),
+                    "probability": confidence, "_text": unit}
+            current.append(word)
+            word_timestamps.append({k: v for k, v in word.items() if k != "_text"})
+            if unit.rstrip() and unit.rstrip()[-1] in _SENTENCE_END:
+                close()
+        close()
+
+        result_data = {
+            "segments": segments,
+            "word_timestamps": word_timestamps,
+            "language": language or box_language or info.language,
+            "duration_seconds": round(float(total), 3),
+            "model_size": model_size,
+            "device": "cpu",
+            "compute_type": "int8",
+            "engine": "box",
+            "words_from": "Qwen3-ASR 1.7B on the box (" + BOX_ASR_URL.split("/v1/")[0] + ")",
+            "timing_from": f"faster-whisper {model_size}",
+            "timing_agreed": round(agreed / max(1, len(units_all)), 3),
+            "gpu_fallback_reason": None,
+        }
+        output_path = output_dir / f"{input_path.stem}_transcript.json"
+        output_path.write_text(json.dumps(result_data, indent=2, ensure_ascii=False), encoding="utf-8")
+        return ToolResult(
+            success=True,
+            data=result_data,
+            artifacts=[str(output_path)],
+            duration_seconds=round(time.time() - start, 2),
+        )
+
