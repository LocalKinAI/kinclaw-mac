@@ -25,6 +38,76 @@ from tools.base_tool import (
     ToolTier,
 )
 
+BOX_ASR_URL = os.environ.get("BOX_ASR_URL", "http://127.0.0.1:8100/v1/audio/transcriptions")
+_CJK = re.compile(r"[㐀-鿿豈-﫿぀-ヿ가-힯]")
+_SENTENCE_END = set("。！？!?；;…")
+_CHUNK_S = 30.0          # the box's ASR hears at most this much at a time, cut where whisper heard a pause
+_PAUSE_S = 0.8           # a silence this long ends a segment even without a full stop
+
+
+def _key(unit: str) -> str:
+    """What is spoken in a unit, for lining the two transcripts up."""
+    return "".join(c.lower() for c in unit if _CJK.match(c) or (c.isascii() and c.isalnum()))
+
+
+def _units(text: str) -> list[str]:
+    """A CJK character, or a run of letters and digits, each; punctuation and spaces ride with
+    the unit before them (or the one after, at the start)."""
+    units: list[str] = []
+    prefix = ""
+    i = 0
+    while i < len(text):
+        c = text[i]
+        if _CJK.match(c):
+            units.append(prefix + c)
+            prefix = ""
+            i += 1
+        elif c.isascii() and c.isalnum():
+            j = i
+            while j < len(text) and text[j].isascii() and (text[j].isalnum() or text[j] in "'-"):
+                j += 1
+            units.append(prefix + text[i:j])
+            prefix = ""
+            i = j
+        else:
+            if units:
+                units[-1] += c
+            elif not c.isspace():
+                prefix += c
+            i += 1
+    return units
+
+
+def _pin(heard: list[tuple[str, float, float]], units: list[str], t0: float, t1: float) -> tuple[list[tuple[float, float, float]], int]:
+    """Times for every unit: whisper's where the two agree, spread over whisper's span where
+    they differ, interpolated where whisper heard nothing. (start, end, confidence) each."""
+    keys = [_key(u) for u in units]
+    sm = difflib.SequenceMatcher(None, [k for k, *_ in heard], keys, autojunk=False)
+    times: list[Optional[tuple[float, float, float]]] = [None] * len(units)
+    for tag, i1, i2, j1, j2 in sm.get_opcodes():
+        if tag == "equal":
+            for k in range(i2 - i1):
+                times[j1 + k] = (heard[i1 + k][1], heard[i1 + k][2], 1.0)
+        elif tag == "replace":
+            a, b = heard[i1][1], heard[i2 - 1][2]
+            for k in range(j2 - j1):
+                times[j1 + k] = (a + (b - a) * k / (j2 - j1), a + (b - a) * (k + 1) / (j2 - j1), 0.5)
+    k = 0
+    while k < len(times):
+        if times[k] is not None:
+            k += 1
+            continue
+        j = k
+        while j < len(times) and times[j] is None:
+            j += 1
+        a = times[k - 1][1] if k else t0
+        b = times[j][0] if j < len(times) else t1
+        for q in range(k, j):
+            times[q] = (a + (b - a) * (q - k) / (j - k), a + (b - a) * (q - k + 1) / (j - k), 0.3)
+        k = j
+    agreed = sum(block.size for block in sm.get_matching_blocks())
+    return times, agreed  # type: ignore[return-value]
+
 
