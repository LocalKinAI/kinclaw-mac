+# ---------------------------------------------------------------- pictures made elsewhere
+
+PICTURE_SUFFIXES = (".png", ".jpg", ".jpeg", ".webp")
+
+
+def given_picture(path: str, task_id: str, index: int) -> str:
+    """A finished picture handed in for a scene — drawn and fixed elsewhere (the app's 画 and 改,
+    Qwen-Image-2.1-Turbo), copied to the box by pv.py — taken into the task as frames/NN_image.png.
+    Only a picture file under Pixelle's own folder is taken: the API reads whatever it is pointed at."""
+    from PIL import Image
 
+    from pixelle_video.utils.os_util import get_pixelle_video_root_path, get_task_frame_path
 
+    root = Path(get_pixelle_video_root_path()).resolve()
+    source = Path(path).expanduser()
+    source = (source if source.is_absolute() else root / source).resolve()
+    if root not in source.parents or not source.is_file() or source.suffix.lower() not in PICTURE_SUFFIXES:
+        raise ValueError(f"images: {path} is not a picture file under {root}")
+    target = Path(get_task_frame_path(task_id, index, "image"))
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with Image.open(source) as picture:
+        picture.convert("RGB").save(target, "PNG")
+    return str(target)
+
