+SOUND_SUFFIXES = (".wav", ".mp3", ".flac", ".m4a")
+
+
+def given_sound(path: str, task_id: str, index: int) -> str:
+    """A finished voice-over handed in for a scene — read by the narrator chosen elsewhere (a designed voice cloned
+    line by line, each line heard back) — taken into the task as frames/NN_audio.<ext>. As with pictures, only a
+    sound file under Pixelle's own folder is taken."""
+    from pixelle_video.utils.os_util import get_pixelle_video_root_path, get_task_frame_path
+
+    root = Path(get_pixelle_video_root_path()).resolve()
+    source = Path(path).expanduser()
+    source = (source if source.is_absolute() else root / source).resolve()
+    if root not in source.parents or not source.is_file() or source.suffix.lower() not in SOUND_SUFFIXES:
+        raise ValueError(f"audios: {path} is not a sound file under {root}")
+    target = Path(get_task_frame_path(task_id, index, "audio")).with_suffix(source.suffix.lower())
+    target.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(source, target)
     return str(target)
 
 
